# ============================================
# GTL AI Security Platform - Environment Configuration
# ============================================

# ============================================
# CAI FRAMEWORK
# ============================================
CAI_MODEL=alias0
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
SHODAN_API_KEY=your-shodan-api-key-here

CAI_DEBUG=1
CAI_GUARDRAILS=true
CAI_PRICE_LIMIT=100.0

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://gtl_user:gtl_password@postgres:5432/gtl_security
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ============================================
# API GATEWAY
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_RATE_LIMIT=100  # requests per minute

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# ============================================
# SECURITY SCANNER
# ============================================
SCAN_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SCANS=5
SCAN_RESULTS_DIR=/app/scan_results
NMAP_PATH=/usr/bin/nmap
NUCLEI_PATH=/usr/bin/nuclei
NIKTO_PATH=/usr/bin/nikto
SQLMAP_PATH=/usr/bin/sqlmap

# ============================================
# THREAT DETECTOR
# ============================================
THREAT_DETECTION_ENABLED=true
ML_MODEL_PATH=/app/gtl_threat_detector/ml_models/trained_models
ANOMALY_THRESHOLD=0.85
ALERT_COOLDOWN_MINUTES=5

# ============================================
# COMPLIANCE AUDITOR
# ============================================
HIPAA_RULES_PATH=/app/config/hipaa_rules.yaml
ISO27001_RULES_PATH=/app/config/iso27001_rules.yaml
SUNAT_RULES_PATH=/app/config/sunat_rules.yaml

# ============================================
# ALERTING
# ============================================
# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@gtl.pe
SMTP_PASSWORD=your-smtp-password
ALERT_EMAIL_FROM=alerts@gtl.pe
ALERT_EMAIL_TO=security@gtl.pe

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#security-alerts

# Webhooks
CUSTOM_WEBHOOK_URL=https://your-webhook.com/alerts
WEBHOOK_SECRET=your-webhook-secret

# ============================================
# CELERY (Task Queue)
# ============================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=America/Lima

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/gtl/app.log

# ============================================
# DEPLOYMENT
# ============================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
WORKERS=4

# ============================================
# GTL SPECIFIC
# ============================================
GTL_ORGANIZATION=GTL Security Peru
GTL_CONTACT_EMAIL=contact@gtl.pe
GTL_REGION=peru
GTL_TIMEZONE=America/Lima
GTL_LANGUAGE=es

# Client Portal
CLIENT_PORTAL_URL=https://portal.gtl.pe
REPORT_RETENTION_DAYS=365

# Pricing
PRICING_TIER=professional  # starter, professional, enterprise
BILLING_EMAIL=billing@gtl.pe
